{
  "name": "@dashhaus/field",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "description": "The Field skin for Home Assistant: hardware-style React modules and page furniture, and custom:dashhaus-field, a Lovelace card drawn from YAML.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "react",
    "dashboard",
    "custom-card",
    "skin"
  ],
  "homepage": "https://krystosterone.github.io/dashhaus/",
  "bugs": {
    "url": "https://github.com/Krystosterone/dashhaus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krystosterone/dashhaus.git",
    "directory": "src/skins/field"
  },
  "author": "Krystian Czesak",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lovelace/card": {
      "source": "./lovelace/card.tsx",
      "types": "./dist/lovelace/card.d.ts",
      "import": "./dist/lovelace/card.js",
      "default": "./dist/lovelace/card.js"
    },
    "./resource": {
      "source": "./resource.js",
      "types": "./dist/resource.d.ts",
      "import": "./dist/resource.js",
      "default": "./dist/resource.js"
    },
    "./storybook": {
      "source": "./storybook.tsx",
      "types": "./dist/storybook.d.ts",
      "import": "./dist/storybook.js",
      "default": "./dist/storybook.js"
    },
    "./styles/tokens.css": {
      "source": "./styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    }
  },
  "dependencies": {
    "@dashhaus/core": "^0.7.0"
  },
  "peerDependencies": {
    "home-assistant-js-websocket": "^9.7.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "home-assistant-js-websocket": {
      "optional": true
    }
  }
}
