{
  "name": "@dashhaus/orb",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "The Orb skin for Home Assistant: React cards, bundles and dashboard furniture, and custom:dashhaus-orb, a Lovelace card drawn from YAML.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "react",
    "dashboard",
    "custom-card",
    "skin"
  ],
  "homepage": "https://krystosterone.github.io/dashhaus/",
  "bugs": {
    "url": "https://github.com/Krystosterone/dashhaus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krystosterone/dashhaus.git",
    "directory": "src/skins/orb"
  },
  "author": "Krystian Czesak",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lovelace/card": {
      "source": "./lovelace/card.tsx",
      "types": "./dist/lovelace/card.d.ts",
      "import": "./dist/lovelace/card.js",
      "default": "./dist/lovelace/card.js"
    },
    "./lovelace/auto": {
      "source": "./lovelace/auto.ts",
      "types": "./dist/lovelace/auto.d.ts",
      "import": "./dist/lovelace/auto.js",
      "default": "./dist/lovelace/auto.js"
    },
    "./storybook": {
      "source": "./storybook.tsx",
      "types": "./dist/storybook.d.ts",
      "import": "./dist/storybook.js",
      "default": "./dist/storybook.js"
    },
    "./styles/tokens.css": {
      "source": "./styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    }
  },
  "dependencies": {
    "@dashhaus/core": "^0.2.0",
    "@dashhaus/dashboard": "^0.2.0"
  },
  "peerDependencies": {
    "home-assistant-js-websocket": "^9.7.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "home-assistant-js-websocket": {
      "optional": true
    }
  }
}
