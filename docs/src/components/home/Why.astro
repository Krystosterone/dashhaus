---
/**
 * Why someone would pick Orb or Field over Home Assistant's own dashboards, in three claims the skins keep and their tests
 * hold, said for the person installing it, in Orb's language: each claim led by Orb's round yellow button. The full
 * case is the Why page.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** Each icon is drawn on a 24-unit grid at a 2-unit round stroke, as the site's arrows are. */
const REASONS = [
  {
    name: "It holds still",
    text: "A card never changes height when its state changes, so nothing jumps when a light turns on. The same dashboard reads on a phone in your hand and a wall panel across the room.",
    icon: `<path d="M3 4h18M3 20h18" /><rect x="5" y="8" width="14" height="8" rx="2.5" />`,
  },
  {
    name: "It lays itself out",
    text: "With no YAML at all, it groups your house by area and keeps up as you add devices. When you want your own order, you write it in Home Assistant's own editor.",
    icon: `<rect x="4" y="4" width="7" height="7" rx="1.75" /><rect x="13" y="4" width="7" height="7" rx="1.75" /><rect x="4" y="13" width="7" height="7" rx="1.75" /><rect x="13" y="13" width="7" height="7" rx="1.75" />`,
  },
  {
    name: "It stays in your house",
    text: "It uses Home Assistant's own signed-in connection: there's no token in it and no account to make. Free and open source, under the MIT licence.",
    icon: `<path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4v-5H9v5H5a1 1 0 0 1-1-1z" />`,
  },
] as const;
---

<section class="why not-content" aria-labelledby="why">
  <div class="head">
    <h2 id="why">Why Orb and Field</h2>
    <a class="more" href={`${base}/why/`}>
      The whole case
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
  <ul>
    {
      REASONS.map(({ name, text, icon }) => (
        <li>
          <span class="orb" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
          </span>
          <div>
            <h3>{name}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .why {
    --pad: clamp(1rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 7rem);
    width: min(100vw, 84rem);
    margin: clamp(6rem, 12vh, 10rem) calc(50% - min(50vw, 42rem)) 0;
    padding-inline: var(--pad);
  }

  .head {
    align-self: start;
    position: sticky;
    top: calc(var(--sl-nav-height) + 8vh);
  }

  h2 {
    margin: 0;
    font-family: var(--home-display);
    font-size: clamp(2rem, 1rem + 2.6vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }

  ul {
    display: grid;
    gap: clamp(2rem, 5vh, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* Orb's main control: a raised round button in its yellow, a soft light from above and a shadow under it. */
  .orb {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--home-orb);
    color: var(--home-orb-ink);
    box-shadow:
      inset 0 1px 0 oklch(1 0 0 / 0.55),
      0 8px 18px -8px oklch(0.55 0.12 80 / 0.55);
  }

  h3 {
    margin: 0.25rem 0 0;
    font-family: var(--home-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--sl-color-white);
  }

  p {
    max-width: 48ch;
    margin: 0.5rem 0 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .more svg {
    color: var(--sl-color-accent);
    transition: transform 160ms var(--home-ease);
  }

  .more:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .more:hover svg {
      transform: translateX(4px);
    }
  }

  @media (max-width: 50rem) {
    .why {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .head {
      position: static;
    }

    li {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: 1rem;
    }

    .orb {
      width: 3.25rem;
      height: 3.25rem;
    }

    .orb svg {
      width: 22px;
      height: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more svg {
      transition: none;
    }
  }
</style>
