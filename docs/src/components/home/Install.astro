---
/**
 * A skin's install, on its landing page: the Marketplace's three steps, the same ones its repository's README and
 * llms.txt give, on one field, and the button that opens its repository in Home Assistant on the other. The command
 * line is one link away, never a second front door (spec/journeys.md → The user).
 */
import { skin as skinNamed } from "../../lib/skins";
import type { SiteSkin } from "../../lib/skins";

interface Props {
  /** The skin, by its id. */
  skin: SiteSkin["skin"];
}

const skin = skinNamed(Astro.props.skin);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const STEPS = [
  { name: "Download it", text: `Open ${skin.name} in your Home Assistant's Marketplace and press Download. Before Home Assistant 2026.11 it opens in HACS, which you install first. If it asks, add it as a custom repository of type Dashboard.` },
  { name: "Reload the tab", text: "So Home Assistant loads what it just installed." },
  { name: "Add the dashboard", text: `Settings, Dashboards, Add dashboard: pick ${skin.name} under Community dashboards and press Create. It opens from the sidebar, laid out by area.` },
] as const;
---

<section class="install not-content" aria-labelledby="install" data-skin={skin.skin}>
  <div class="field lead">
    <h2 id="install">Installed in three steps</h2>
    <p>
      All of it in Home Assistant 2026.5 or newer, in your browser, as an administrator. Nothing to install on your
      computer, no token to copy, and it never changes a dashboard you already have.
    </p>
    <div class="links">
      <a class="solid" href={skin.myLink} target="_blank" rel="external noopener">
        Open in Home Assistant<span class="sr-only"> (opens in a new tab, so these steps stay here)</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path d="M7 17 17 7m-8 0h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="plain" href="#settings">Settings</a>
    </div>
    <p class="aside">
      Prefer a terminal, or deploying from CI? <a href={`${base}/start/deploy/`}>Deploy from the command line</a> instead.
      Pick one way: both at once would load {skin.name} twice.
    </p>
  </div>
  <ol class="field steps">
    {
      STEPS.map(({ name, text }) => (
        <li>
          <strong>{name}</strong>
          <span>{text}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .install {
    --pad: clamp(1rem, 4vw, 3rem);
    /* The page's margin on the outer edge of each field, as the sections above and below set theirs. */
    --edge: max(var(--pad), calc(50vw - 42rem + var(--pad)));
    --ink: oklch(0.22 0.006 80);
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100vw;
    margin: clamp(4rem, 9vh, 7rem) calc(50% - 50vw) 0;
  }

  .field {
    min-width: 0;
    margin: 0;
    padding: clamp(3rem, 9vh, 6rem) var(--pad) clamp(3rem, 9vh, 6rem) var(--edge);
    background: var(--home-tone);
  }

  .field + .field {
    padding: clamp(3rem, 9vh, 6rem) var(--edge) clamp(3rem, 9vh, 6rem) var(--pad);
    background: var(--home-tone-2);
  }

  .lead {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  h2 {
    margin: 0;
    font-family: var(--home-display);
    font-size: clamp(2rem, 1rem + 2.6vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }

  .lead p {
    max-width: 40ch;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms var(--home-ease),
      transform 160ms var(--home-ease);
  }

  .links a:active {
    transform: scale(0.97);
  }

  /* The skin's own colour, as its way in in the hero: Orb's yellow, Field's orange. */
  .links .solid {
    background: var(--solid, oklch(0.86 0.145 92));
    color: var(--ink);
  }

  .install[data-skin="field"] {
    --solid: oklch(0.72 0.19 42);
  }

  .links .plain {
    background: var(--home-tone-2);
    color: var(--sl-color-white);
  }

  .links a:focus-visible,
  .aside a:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 3px;
  }

  .lead .aside {
    font-size: 0.9375rem;
    color: var(--sl-color-gray-3);
  }

  .aside a {
    color: var(--sl-color-white);
    text-underline-offset: 3px;
  }

  .steps {
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 4vh, 2.5rem);
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 1.25rem;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-family: var(--home-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .steps strong {
    font-family: var(--home-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--sl-color-white);
  }

  .steps span {
    max-width: 44ch;
    margin-top: 0.25rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .links .solid:hover {
      filter: brightness(1.06);
    }

    .links .plain:hover {
      background: var(--sl-color-gray-5);
    }
  }

  @media (max-width: 50rem) {
    .install {
      grid-template-columns: minmax(0, 1fr);
    }

    .field,
    .field + .field {
      padding: 3rem var(--pad);
    }

    .links a {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links a {
      transition: none;
    }
  }
</style>
