---
/**
 * One light, two ways: the light drawn from the headless hook on one field, the same light as Orb draws it on the
 * other, in Orb's colour. Each sample comes in through its slot (`yours`, `orb`) as an `<Example>` on the page.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const PANELS = [
  {
    slot: "yours",
    name: "Drawn your way",
    fact: "useHaLight hands you the light and what it can do, and you write the markup.",
    links: [
      { href: `${base}/start/getting-started/`, text: "Getting started" },
      { href: `${base}/hooks/`, text: "The hooks" },
    ],
  },
  {
    slot: "orb",
    name: "Drawn by Orb",
    fact: "HaLightTile draws the same light with its round button, brightness track and details sheet.",
    links: [
      { href: `${base}/skins/`, text: "Orb and Field" },
      { href: `${base}/entities/`, text: "Entities" },
    ],
  },
] as const;
---

<section class="fields not-content" aria-labelledby="one-light">
  {
    PANELS.map(({ slot, name, fact, links }, index) => (
      <div class="field" data-field={slot}>
        {index === 0 && <h2 id="one-light">One light, two ways</h2>}
        <div class="sample">{slot === "yours" ? <slot name="yours" /> : <slot name="orb" />}</div>
        <div class="row">
          <p>
            <strong>{name}</strong>
            {fact}
          </p>
          <div class="links">
            {links.map(({ href, text }, i) => (
              <a href={href} class={i === 0 ? "solid" : "plain"}>
                {text}
              </a>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</section>

<style>
  .fields {
    --pad: clamp(1rem, 4vw, 3rem);
    /* The page's margin on the outer edge of each field, as the sections above and below set theirs. */
    --edge: max(var(--pad), calc(50vw - 42rem + var(--pad)));
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100vw;
    margin: clamp(6rem, 12vh, 10rem) calc(50% - 50vw) 0;
  }

  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: 2rem;
    min-width: 0;
    min-height: 92svh;
    padding: clamp(3rem, 9vh, 6rem) var(--pad) 2rem var(--edge);
    background: var(--home-tone);
  }

  .field + .field {
    padding: clamp(3rem, 9vh, 6rem) var(--edge) 2rem var(--pad);
  }

  /* Orb's own field: its accent, with ink that reads on it in either theme. */
  .field[data-field="orb"] {
    --ink: oklch(0.22 0.006 80);
    background: oklch(0.86 0.145 92);
    color: var(--ink);
  }

  .field[data-field="orb"] {
    grid-template-rows: 1fr auto;
  }

  h2 {
    margin: 0;
    font-family: var(--home-display);
    font-size: clamp(2rem, 1rem + 2.6vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }

  .sample {
    align-self: center;
    min-width: 0;
    max-width: 40rem;
    width: 100%;
    justify-self: center;
  }

  .sample > :global(*) {
    margin: 0;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .row p {
    max-width: 38ch;
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .row strong {
    display: block;
    font-family: var(--home-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }

  [data-field="orb"] .row p,
  [data-field="orb"] .row strong {
    color: var(--ink);
  }

  .links {
    display: flex;
    gap: 0.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms var(--home-ease),
      transform 160ms var(--home-ease);
  }

  .links a:active {
    transform: scale(0.97);
  }

  .links .solid {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .links .plain {
    background: var(--home-tone-2);
    color: var(--sl-color-white);
  }

  [data-field="orb"] .solid {
    background: var(--ink);
    color: oklch(0.97 0 0);
  }

  [data-field="orb"] .plain {
    background: oklch(0.97 0 0);
    color: var(--ink);
  }

  .links a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .links .plain:hover {
      background: var(--sl-color-gray-5);
    }

    [data-field="orb"] .plain:hover {
      background: oklch(1 0 0);
    }
  }

  @media (max-width: 50rem) {
    .fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .field,
    .field + .field {
      min-height: 0;
      padding: 3rem var(--pad) 2rem;
    }

    .links {
      width: 100%;
    }

    .links a {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links a {
      transition: none;
    }
  }
</style>
