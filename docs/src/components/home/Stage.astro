---
/** One stage of `<Stages>`: its clause, which is the stage's heading, an optional line under it, and its sample. */
interface Props {
  /** The stage as a clause, starting with its order word ("First, install the bundle and the tool"). */
  clause: string;
  /** One sentence the sample doesn't say. */
  line?: string;
}

const { clause, line } = Astro.props;
---

<div class="stage" data-stage>
  <div class="clause">
    <h2>{clause}</h2>
    {line && <p>{line}</p>}
  </div>
  <div class="sample">
    <slot />
  </div>
</div>

<style>
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    max-width: 84rem;
    width: 100%;
    margin-inline: auto;
  }

  .clause,
  .sample {
    padding: clamp(3rem, 9vh, 6rem) var(--pad, 2rem) 3rem;
  }

  .clause {
    padding-right: clamp(2rem, 5vw, 5rem);
  }

  h2 {
    margin: 0;
    font-family: var(--home-display);
    font-size: clamp(2.25rem, 1.6rem + 3.4vw, 4.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  p {
    max-width: 34ch;
    margin: 1.5rem 0 0;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--sl-color-white);
  }

  .sample {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
    min-width: 0;
    padding-left: clamp(2rem, 5vw, 5rem);
  }

  .sample > :global(*) {
    margin: 0;
  }

  /* Every stage shares the tallest one's height, so a long sample scrolls rather than leave the short ones empty. */
  .sample :global(pre) {
    max-height: min(26rem, 52svh);
    overflow-y: auto;
  }

  /* With script, only the current stage shows; the others fade out in place. */
  :global(.js-stages) .stage {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms var(--home-ease),
      visibility 0s 200ms;
  }

  :global(.js-stages) .stage[data-current] {
    opacity: 1;
    visibility: visible;
    transition: opacity 200ms var(--home-ease);
  }

  /* A phone: the sample first, then the clause. */
  @media (max-width: 50rem) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .sample {
      order: -1;
      padding: 2rem var(--pad, 1rem) 1rem;
    }

    .clause {
      padding: 1rem var(--pad, 1rem) 2rem;
    }

    h2 {
      font-size: clamp(2rem, 9vw, 2.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js-stages) .stage,
    :global(.js-stages) .stage[data-current] {
      transition: none;
    }
  }
</style>
