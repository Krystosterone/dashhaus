---
/**
 * The home page's deploy, in stages: each `<Stage>` is a clause on one field and its sample on the other, and one
 * slider steps through them (drag, or the arrow keys). Without script, the stages read one under the other.
 */
interface Props {
  /** The section's name, for its landmark. */
  label: string;
  /** Each stage's short name, under the slider, in the order of the `<Stage>`s. */
  names: string[];
}

const { label, names } = Astro.props;
---

<section class="stages not-content" aria-label={label} data-stages>
  <div class="panels">
    <slot />
  </div>
  <div class="control">
    <div class="rail" aria-hidden="true"><span></span></div>
    <input type="range" min="0" max={names.length - 1} step="1" value="0" aria-label="Step" aria-valuetext={names[0]} data-names={JSON.stringify(names)} />
    <ol class="names">
      {names.map((name, index) => <li data-step={index} aria-current={index === 0 ? "step" : undefined}>{name}</li>)}
    </ol>
  </div>
  <div class="foot">
    <slot name="foot" />
  </div>
</section>

<style>
  .stages {
    --pad: clamp(1rem, 4vw, 3rem);
    position: relative;
    width: 100vw;
    /* Right under the hero, so the hero's cropped shapes meet this field rather than bare page. */
    margin: 0 calc(50% - 50vw);
    isolation: isolate;
    background: var(--home-tone);
  }

  /* The sample's field: the right half, one tone step from the clause's. */
  .stages::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 0 0 50%;
    background: var(--home-tone-2);
  }

  .panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .control,
  .foot {
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .control {
    display: none;
  }

  .foot {
    padding-block: 0 2.5rem;
    font-size: 1rem;
    color: var(--sl-color-gray-2);
  }

  .foot :global(p) {
    max-width: 60ch;
    margin: 0;
  }

  .foot :global(a) {
    color: var(--sl-color-white);
  }

  /* With script: the stages share one place, and the slider shows one at a time. */
  :global(.js-stages) .panels > :global(*) {
    grid-area: 1 / 1;
  }

  :global(.js-stages) .control {
    display: grid;
    gap: 1rem;
    padding-block: 1rem 2rem;
  }

  /* The groove drawn under the native input: flat, the part already passed in full ink up to the thumb's centre. */
  .control {
    position: relative;
  }

  .rail {
    position: absolute;
    top: calc(1rem + 1.25rem - 0.25rem);
    left: var(--pad);
    right: var(--pad);
    height: 0.5rem;
    background: var(--sl-color-gray-5);
    pointer-events: none;
  }

  .rail span {
    display: block;
    width: calc(1rem + (100% - 2rem) * var(--passed, 0));
    height: 100%;
    background: var(--sl-color-white);
    transition: width 200ms var(--home-ease);
  }

  input[type="range"] {
    position: relative;
    width: 100%;
    height: 2.5rem;
    margin: 0;
    background: transparent;
    accent-color: var(--sl-color-accent);
    appearance: none;
    cursor: pointer;
    touch-action: pan-y;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 0.5rem;
    background: transparent;
  }

  input[type="range"]::-moz-range-track {
    height: 0.5rem;
    background: transparent;
  }

  input[type="range"]::-webkit-slider-thumb {
    width: 2rem;
    height: 2rem;
    margin-top: -0.75rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    appearance: none;
    transition: transform 160ms var(--home-ease);
  }

  input[type="range"]::-moz-range-thumb {
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
  }

  input[type="range"]:active::-webkit-slider-thumb {
    transform: scale(1.1);
  }

  input[type="range"]:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
  }

  .names {
    display: grid;
    grid-template-columns: repeat(var(--count, 4), 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    color: var(--sl-color-gray-3);
  }

  .names li {
    cursor: pointer;
    user-select: none;
    transition: color 160ms var(--home-ease);
  }

  .names li:not(:first-child) {
    text-align: center;
  }

  .names li:last-child {
    text-align: right;
  }

  .names li[aria-current] {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  @media (max-width: 50rem) {
    .stages::before {
      display: none;
    }

    .names {
      grid-template-columns: 1fr 1fr;
      gap: 0.25rem 1rem;
      font-size: 0.9375rem;
    }

    .names li:not(:first-child),
    .names li:last-child {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    input[type="range"]::-webkit-slider-thumb,
    .rail span,
    .names li {
      transition: none;
    }
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>("[data-stages]")) {
    document.documentElement.classList.add("js-stages");
    const input = section.querySelector<HTMLInputElement>('input[type="range"]')!;
    const names: string[] = JSON.parse(input.dataset.names!);
    const panels = [...section.querySelectorAll<HTMLElement>("[data-stage]")];
    const labels = [...section.querySelectorAll<HTMLElement>(".names li")];
    section.style.setProperty("--count", String(names.length));

    const show = (step: number) => {
      input.value = String(step);
      input.setAttribute("aria-valuetext", names[step]);
      section.style.setProperty("--passed", String(step / (names.length - 1)));
      panels.forEach((panel, index) => panel.toggleAttribute("data-current", index === step));
      labels.forEach((label, index) => (index === step ? label.setAttribute("aria-current", "step") : label.removeAttribute("aria-current")));
    };

    input.addEventListener("input", () => show(Number(input.value)));
    labels.forEach((label, index) => label.addEventListener("click", () => show(index)));
    show(0);
  }
</script>
