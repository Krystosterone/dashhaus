---
/** The home page's close: the two ways in as one question, read in one view, then its two answers. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="choice not-content" aria-labelledby="choice">
  <h2 id="choice">
    <span>Install one,</span>{" "}
    <span>or build one?</span>
  </h2>
  <div class="answers">
    <a class="solid" href={`${base}/start/install/`}>Install a dashboard</a>
    <a class="plain" href={`${base}/start/build-a-skin/`}>Build a skin</a>
    <p>Both are free and open source.</p>
  </div>
</section>

<style>
  .choice {
    --paper: oklch(0.97 0 0);
    --ink: hsl(224, 10%, 10%);
    width: 100vw;
    margin: clamp(6rem, 12vh, 10rem) calc(50% - 50vw) 0;
    padding: clamp(5rem, 14vh, 9rem) clamp(1rem, 4vw, 3rem);
    background: var(--home-night);
    color: var(--paper);
    text-align: center;
  }

  h2 {
    margin: 0;
    font-family: var(--home-display);
    font-size: clamp(2.75rem, 1rem + 6vw, 6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--paper);
  }

  h2 span {
    display: block;
    white-space: nowrap;
  }

  .answers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    justify-content: center;
    gap: 1rem;
    padding-top: clamp(2.5rem, 6vh, 4rem);
  }

  .answers a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 13rem;
    min-height: 3.5rem;
    padding: 0 1.75rem;
    border-radius: 999px;
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms var(--home-ease),
      transform 160ms var(--home-ease);
  }

  .answers a:active {
    transform: scale(0.97);
  }

  .solid {
    background: oklch(0.86 0.145 92);
    color: var(--ink);
  }

  .plain {
    background: var(--paper);
    color: var(--ink);
  }

  .answers a:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .solid:hover {
      background: oklch(0.9 0.13 92);
    }

    .plain:hover {
      background: oklch(1 0 0);
    }
  }

  .answers p {
    flex-basis: 100%;
    margin: 0.5rem 0 0;
    font-size: 1rem;
    color: oklch(0.75 0.006 80);
  }

  @media (max-width: 40rem) {
    h2 {
      font-size: 12vw;
    }

    .answers {
      flex-direction: column;
      gap: 0.75rem;
    }

    .answers a {
      width: 72%;
    }

    .answers p {
      flex-basis: auto;
      max-width: 28ch;
    }
  }

  /* The splash page's footer holds nothing here (no edit link, no pagination); its padding would leave a strip under
     the dark band. */
  :global(main:has(.choice) footer) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .answers a {
      transition: none;
    }
  }
</style>
