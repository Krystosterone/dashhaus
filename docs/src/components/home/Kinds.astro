---
/**
 * What the skins draw: every kind of entity, each a link to its page, beside one picture that follows the row being
 * read (hovered, focused, or nearest the middle of the screen): that kind's Orb tile over its Field module. The
 * pictures come from `npm run screenshots -w docs`; on a narrow page the list stands alone.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pictures = import.meta.glob<{ default: ImageMetadata }>("../../assets/kinds/*.webp", { eager: true });
const picture = (kind: string, look: "light" | "dark") => pictures[`../../assets/kinds/${kind}-${look}.webp`].default;

const KINDS = [
  { kind: "light", name: "Light", hook: "useHaLight", text: "On and off, brightness, colour temperature and colour." },
  { kind: "climate", name: "Climate", hook: "useHaClimate", text: "A thermostat, heat pump or air conditioner, its setpoints and modes." },
  { kind: "cover", name: "Cover", hook: "useHaCover", text: "Curtains, blinds, shades, garage doors and gates." },
  { kind: "toggle", name: "Toggle", hook: "useHaToggle", text: "A switch or input_boolean used as a mode: Guest mode, Do Not Disturb." },
  { kind: "fan", name: "Fan", hook: "useHaFan", text: "On and off, its speed, presets, oscillation and a ceiling fan's direction." },
  { kind: "sound", name: "Sound", hook: "useHaSound", text: "A sound machine: the switch that plays it and its volume." },
  { kind: "humidifier", name: "Humidifier", hook: "useHaHumidifier", text: "On and off, a target humidity and a mode. Dehumidifiers too." },
  { kind: "sensor", name: "Sensor", hook: "useHaSensor", text: "A room's temperature, read with its device's humidity and battery." },
  { kind: "weather", name: "Weather", hook: "useHaWeather", text: "Outdoor conditions, air quality, the sun and the forecast." },
  { kind: "alarm", name: "Alarm", hook: "useHaAlarm", text: "Its state, arm modes, the code and the exit and entry delays." },
  { kind: "lock", name: "Lock", hook: "useHaLock", text: "A door lock and its battery: one tap locks, unlocking always asks first." },
  { kind: "owlet", name: "Owlet", hook: "useHaOwlet", text: "A sock's sleep state, heart rate, oxygen, alerts and base station." },
];
---

<section class="kinds not-content" aria-labelledby="what-it-draws" data-kinds>
  <div class="picture" aria-hidden="true">
    {
      KINDS.map(({ kind }, index) => (
        <div class="frame" data-kind={kind} data-current={index === 0 || undefined}>
          <Image class="light:sl-hidden" src={picture(kind, "dark")} alt="" width={480} loading={index === 0 ? "eager" : "lazy"} />
          <Image class="dark:sl-hidden" src={picture(kind, "light")} alt="" width={480} loading={index === 0 ? "eager" : "lazy"} />
        </div>
      ))
    }
  </div>
  <div class="list">
    <h2 id="what-it-draws">What it draws</h2>
    <ul>
      {
        KINDS.map(({ kind, name, hook, text }, index) => (
          <li data-kind={kind} data-current={index === 0 || undefined}>
            <a href={`${base}/entities/${kind}/`}>
              <span class="name">{name}</span>
              <code>{hook}</code>
            </a>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .kinds {
    --pad: clamp(1rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 7rem);
    width: min(100vw, 84rem);
    margin: clamp(6rem, 12vh, 10rem) calc(50% - min(50vw, 42rem)) 0;
    padding-inline: var(--pad);
  }

  .picture {
    position: sticky;
    top: calc(var(--sl-nav-height) + 8vh);
    display: grid;
    align-self: start;
    aspect-ratio: 4 / 5;
    border-radius: 1.5rem;
    overflow: hidden;
  }

  .frame {
    position: relative;
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 240ms var(--home-ease);
  }

  .frame[data-current] {
    opacity: 1;
  }

  /* Positioned, not displayed: Starlight's light:sl-hidden and dark:sl-hidden pick one of each pair. */
  .frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h2 {
    margin: 0 0 2rem;
    font-family: var(--home-display);
    font-size: clamp(2rem, 1rem + 2.6vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.875rem 0 1rem;
  }

  li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 160ms var(--home-ease);
  }

  .name {
    font-family: var(--home-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  code {
    font-size: 0.9375rem;
    color: var(--sl-color-gray-3);
    background: none;
    padding: 0;
  }

  li p {
    max-width: 44ch;
    margin: 0.25rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  li[data-current] a {
    color: var(--sl-color-white);
  }

  li[data-current] .name {
    text-decoration: underline;
    text-decoration-color: var(--sl-color-accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  li a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Below the sidebar breakpoint there is no room for the picture beside the list, and pinned over it, it would
     cover the rows scrolling under it: the list stands alone. */
  @media (max-width: 50rem) {
    .kinds {
      grid-template-columns: minmax(0, 1fr);
    }

    .picture {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    li a {
      transition: none;
    }
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>("[data-kinds]")) {
    const rows = [...section.querySelectorAll<HTMLElement>("li[data-kind]")];
    const frames = [...section.querySelectorAll<HTMLElement>(".frame")];
    let current = rows[0]?.dataset.kind;

    const show = (kind: string | undefined) => {
      if (!kind || kind === current) return;
      current = kind;
      for (const el of [...rows, ...frames]) el.toggleAttribute("data-current", el.dataset.kind === kind);
    };

    for (const row of rows) {
      row.addEventListener("pointerenter", () => show(row.dataset.kind));
      row.addEventListener("focusin", () => show(row.dataset.kind));
    }

    /** While the pointer is over the list, it picks the row; scrolling only picks one when it isn't. */
    const list = section.querySelector("ul")!;
    let pointing = false;
    list.addEventListener("pointerenter", () => (pointing = true));
    list.addEventListener("pointerleave", () => (pointing = false));

    /** As the page scrolls, the row crossing the middle of the screen. */
    let ticking = false;
    const onScroll = () => {
      if (ticking || pointing) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const y = innerHeight / 2;
        const bounds = section.getBoundingClientRect();
        if (bounds.bottom < 0 || bounds.top > innerHeight) return;
        const row = rows.find((r) => r.getBoundingClientRect().bottom >= y) ?? rows.at(-1);
        show(row?.dataset.kind);
      });
    };
    addEventListener("scroll", onScroll, { passive: true });
  }
</script>
