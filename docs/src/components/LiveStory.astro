---
/**
 * A Storybook story drawn live in the page: the repository's own stories on the demo house, so a press or a slide
 * works as it does on a dashboard. The frame keeps the story's device width and scales down to fit the column, and
 * the story follows the site's light or dark theme through the skin's own Storybook toolbar global.
 *
 * With `screen`, only the device's screen shows (the Examples stories' `Device` caption and margins are cut away),
 * rounded as the story rounds it, over a `poster` until the story has loaded.
 *
 * In a build, Storybook is the copy `npm run build:docs` puts under /storybook; under `npm run docs`, it is
 * `npm run storybook` on port 6006.
 *
 * Just after a deploy, a browser can still hold the last deploy's `iframe.html` (Pages lets it keep HTML for minutes),
 * which imports story chunks by names the new deploy no longer has, and Storybook shows "Importing a module script
 * failed". A frame that lands on Storybook's error screen reloads once under a new URL, which the cache has never seen.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { story, storybookUrl } from "../lib/stories";

interface Props {
  /** The story id, as in Storybook's URL (`orb-dashboards-examples--phone`). */
  id: string;
  /** What the story shows, for the frame's accessible name. */
  title: string;
  /** The device, in the note a narrow page shows instead of a wide story (`Tablet`). */
  device: string;
  /** The story's device frame (`Device` in the Examples stories). */
  width: number;
  height: number;
  /** The toolbar global for each site theme (`theme:light`, `finish:black`). */
  light: string;
  dark: string;
  /**
   * Show the device's screen alone: where it starts below the frame's top and its corner radius, in story pixels.
   * `top` is a fallback; when the story is served from this site, the screen's place is measured from it.
   */
  screen?: { top: number; radius: number };
  /** A still of the screen for each site theme, shown until the story loads (`npm run screenshots -w docs`). */
  poster?: { light: ImageMetadata; dark: ImageMetadata; alt: string };
  /** The "Open in Storybook" link under the frame. */
  link?: boolean;
  /**
   * Start the story inert, under a button with this label (`Try Orb live`), so a page can be scrolled past it and
   * tabbed past it in one stop. A press, or a fine pointer coming over it, makes it live. Where the story is the page's
   * subject (the skins page), leave it out.
   */
  arm?: string;
}

const { id: given, title, device, width, height, light, dark, screen, poster, link = true, arm } = Astro.props;
/** Checked against the story files, so a renamed story fails the build instead of drawing "story not found". */
const id = story(given);
/** A story wider than a phone (a tablet, a wall panel) would shrink past reading on one, so a narrow page links it. */
const wide = width > 600;
const storybook = storybookUrl();
const src = (globals: string) => `${storybook}iframe.html?id=${id}&viewMode=story&globals=${globals}`;
/** The poster at one, two and three device pixels a CSS pixel, as wide as the frame (it never grows past `width`). */
const posterWidths = [1, 2, 3].map((density) => width * density);
const posterSizes = `min(100vw, ${width}px)`;
/** The Examples stories' `Device` adds its caption and margins around the screen. */
const frame = height + 72;
const style = screen
  ? `--w: ${width}; --h: ${height}; --frame: ${frame}; --top: ${screen.top}; --r: ${screen.radius}; max-width: ${width}px`
  : `--w: ${width}; --h: ${frame}; --frame: ${frame}; --top: 0; max-width: ${width}px`;
---

<div class="live-story" data-live-story data-screen={screen ? "" : undefined} data-wide={wide || undefined} data-arm={arm ? "" : undefined} style={style}>
  {
    poster && (
      <>
        <Image class="poster light:sl-hidden" src={poster.dark} alt={poster.alt} widths={posterWidths} sizes={posterSizes} loading="eager" />
        <Image class="poster dark:sl-hidden" src={poster.light} alt={poster.alt} widths={posterWidths} sizes={posterSizes} loading="eager" />
      </>
    )
  }
  <iframe title={title} loading="lazy" width={width} height={frame} data-light={src(light)} data-dark={src(dark)} inert={arm ? true : undefined}></iframe>
  {
    arm && (
      <button type="button" class="arm">
        <span>{arm}</span>
      </button>
    )
  }
</div>
{
  link && (
    <p class="live-story-link" data-wide={wide || undefined}>
      <a href={`${storybook}?path=/story/${id}`} target="_blank" rel="noopener">
        Open in Storybook
      </a>
    </p>
  )
}
{
  wide && (
    <p class="live-story-note">
      <strong>{device} layout.</strong> It is {width} px wide, so it shows on a larger screen.{" "}
      <a href={`${storybook}?path=/story/${id}`} target="_blank" rel="noopener">
        Open it in Storybook
      </a>
    </p>
  )
}

<style>
  .live-story {
    --s: 1;
    position: relative;
    height: calc(var(--h) * var(--s) * 1px);
    overflow: hidden;
  }

  /* Sized here, not by Starlight's content styles (`height: auto`, `max-width: 100%`), which would cut the story
     short and narrow it before it is scaled. */
  iframe {
    position: absolute;
    inset: 0 auto auto 0;
    width: calc(var(--w) * 1px);
    height: calc(var(--frame) * 1px);
    max-width: none;
    margin: 0;
    border: 0;
    transform: translateY(calc(var(--top) * var(--s) * -1px)) scale(var(--s));
    transform-origin: top left;
  }

  /* The screen alone: rounded as the story rounds it, the still under it until the story has drawn. */
  .live-story[data-screen] {
    border-radius: calc(var(--r) * var(--s) * 1px);
    isolation: isolate;
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    margin: 0;
    object-fit: cover;
    object-position: top;
  }

  [data-screen] iframe {
    opacity: 0;
    transition: opacity 300ms var(--ease-out, ease-out);
  }

  [data-screen] iframe[data-ready] {
    opacity: 1;
  }

  /* Over an inert story: the whole screen is the button, its label a pill at the foot. */
  .arm {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 8%;
    border: 0;
    border-radius: inherit;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .arm span {
    padding: 0.625rem 1.125rem;
    border-radius: 999px;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 600;
    box-shadow: 0 6px 20px -6px rgb(0 0 0 / 0.35);
    transition: transform 160ms var(--home-ease, ease-out);
  }

  .arm:active span {
    transform: scale(0.96);
  }

  .arm:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  [data-armed] .arm {
    display: none;
  }

  .live-story-link {
    font-size: var(--sl-text-sm);
  }

  .live-story-note {
    display: none;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  /* Below Starlight's sidebar breakpoint, a wide story would draw at a third of its size: a note links it instead. */
  @media (max-width: 50rem) {
    .live-story[data-wide],
    .live-story-link[data-wide] {
      display: none;
    }

    .live-story-note {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-screen] iframe,
    .arm span {
      transition: none;
    }
  }
</style>

<script>
  const frames = [...document.querySelectorAll<HTMLElement>("[data-live-story]")];

  /** Scale each story down to its column; it never grows past its device width. */
  const fit = new ResizeObserver((entries) => {
    for (const { target, contentRect } of entries) {
      const width = Number(getComputedStyle(target).getPropertyValue("--w"));
      (target as HTMLElement).style.setProperty("--s", String(Math.min(1, contentRect.width / width)));
    }
  });

  /** A screen-only story shows once it has drawn; served from this site, its screen's top is measured, not assumed. */
  const reveal = (frame: HTMLElement, iframe: HTMLIFrameElement) => {
    if (!frame.hasAttribute("data-screen")) return;
    let tries = 0;
    const look = () => {
      let doc: Document | null = null;
      try {
        doc = iframe.contentDocument;
      } catch {
        doc = null;
      }
      const screen = doc?.querySelector("#storybook-root figure > div");
      if (screen) {
        frame.style.setProperty("--top", String(screen.getBoundingClientRect().top + (doc!.defaultView?.scrollY ?? 0)));
        iframe.setAttribute("data-ready", "");
      } else if (!doc || ++tries > 120) {
        iframe.setAttribute("data-ready", "");
      } else {
        requestAnimationFrame(look);
      }
    };
    look();
  };

  /** Point each story at the site's current theme; a theme change reloads it in the other look. */
  const follow = () => {
    const theme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
    for (const frame of frames) {
      const iframe = frame.querySelector("iframe")!;
      const fresh = frame.dataset.fresh;
      const src = iframe.dataset[theme]! + (fresh ? `&fresh=${fresh}` : "");
      if (iframe.getAttribute("src") === src) continue;
      iframe.removeAttribute("data-ready");
      iframe.setAttribute("src", src);
    }
  };

  /**
   * Storybook's error screen (`sb-show-errordisplay` on its body), most often a stale `iframe.html` asking for a chunk
   * the latest deploy replaced: load the story once more under a URL no cache holds. A second failure is a real one,
   * and Storybook's message stays.
   */
  const recover = (frame: HTMLElement, iframe: HTMLIFrameElement) => {
    let body: HTMLElement | null | undefined;
    try {
      body = iframe.contentDocument?.body;
    } catch {
      body = null;
    }
    if (!body || frame.dataset.fresh) return;
    const check = () => {
      if (!body.classList.contains("sb-show-errordisplay")) return;
      watch.disconnect();
      frame.dataset.fresh = String(Date.now());
      follow();
    };
    const watch = new MutationObserver(check);
    watch.observe(body, { attributes: true, attributeFilter: ["class"] });
    check();
  };

  /** An armed story starts inert: a press makes it live and hands it the focus; a fine pointer arriving does too. */
  const fine = matchMedia("(hover: hover) and (pointer: fine)");
  const arm = (frame: HTMLElement, iframe: HTMLIFrameElement, focus: boolean) => {
    if (frame.hasAttribute("data-armed")) return;
    frame.setAttribute("data-armed", "");
    iframe.inert = false;
    if (focus) iframe.focus();
  };

  for (const frame of frames) {
    const iframe = frame.querySelector("iframe")!;
    iframe.addEventListener("load", () => {
      reveal(frame, iframe);
      recover(frame, iframe);
    });
    fit.observe(frame);
    const button = frame.querySelector<HTMLButtonElement>(".arm");
    if (button) {
      button.addEventListener("click", () => arm(frame, iframe, true));
      frame.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse" && fine.matches) arm(frame, iframe, false);
      });
    }
  }
  follow();
  new MutationObserver(follow).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
</script>
