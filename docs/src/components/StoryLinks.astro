---
/**
 * An entity page's way into Storybook: a link to each skin's All states story of the kind's card, for every skin that
 * draws it (`src/lib/kinds.ts`), each id checked against the story files (`src/lib/stories.ts`).
 */
import { kinds } from "../lib/kinds";
import { story, storybookUrl, storyId } from "../lib/stories";

interface Props {
  kind: string;
}

const { kind: name } = Astro.props;
const kind = (await kinds()).find((entry) => entry.name === name);
if (!kind) throw new Error(`StoryLinks: no kind ${name}`);
// Stories are titled by the card's name ("GuestWifi"), which a one-word kind's page title happens to match.
const Name = name[0].toUpperCase() + name.slice(1);
const skins = [
  kind.tile && { skin: "Orb", id: story(storyId(`Orb/Cards/${Name}`, "AllStates")) },
  kind.module && { skin: "Field", id: story(storyId(`Field/Cards/${Name}`, "AllStates")) },
].filter((entry): entry is { skin: string; id: string } => Boolean(entry));
const href = (id: string) => `${storybookUrl()}?path=/story/${id}`;
---

{
  skins.length > 0 && (
    <p>
      Every state of {skins.length > 1 ? "both" : "it"} is in Storybook:{" "}
      {skins.map((entry, index) => <>{index > 0 && " and "}<a href={href(entry.id)}>{entry.skin}</a></>)}.
    </p>
  )
}
