---
/**
 * Every study in the repository (spec/skins.md → Studies), read at build time from each skin's manifest
 * (`dashhaus.study`) and its `study.json`: its description and reference, its phone Examples story drawn live, and
 * links to its Read me first page, the agent's report when the study is a kept run, and its source. Every study has
 * the same shape, so a new one needs no edit to this page.
 */
import LiveStory from "./LiveStory.astro";
import { docsId, story, storybookUrl, storyId } from "../lib/stories";

interface Manifest {
  name: string;
  description?: string;
  dashhaus?: { study?: { theme: { global: string; light: string; dark: string } } };
}

interface StudyRecord {
  made: "run" | "generators";
  reference?: { kind: "image"; file: string; withdrawn?: true } | { kind: "description"; text: string };
}

const manifests = import.meta.glob<Manifest>("../../../src/skins/*/package.json", { eager: true, import: "default" });
const setups = import.meta.glob<string>("../../../src/skins/*/storybook.tsx", { eager: true, query: "?raw", import: "default" });
const records = import.meta.glob<StudyRecord>("../../../src/skins/*/study.json", { eager: true, import: "default" });
const references = import.meta.glob<string>("../../../src/skins/*/reference.*", { eager: true, query: "?url", import: "default" });
const repo = "https://github.com/Krystosterone/dashhaus";
const storybook = storybookUrl();

const studies = Object.entries(manifests)
  .flatMap(([path, manifest]) => {
    const marker = manifest.dashhaus?.study;
    if (!marker) return [];
    const folder = path.replace(/\/package\.json$/, "");
    const dir = folder.split("/").at(-1)!;
    const section = setups[`${folder}/storybook.tsx`]?.match(/^\s*section: "([^"]+)",?$/m)?.[1];
    if (!section) throw new Error(`src/skins/${dir}/storybook.tsx declares no section`);
    const record = records[`${folder}/study.json`];
    if (!record) throw new Error(`src/skins/${dir} is a study with no study.json`);
    const reference = record.reference?.kind === "image" ? { image: references[`${folder}/${record.reference.file}`] } : record.reference ? { text: record.reference.text } : undefined;
    const name = section.split("/").at(-1)!;
    const { global, light, dark } = marker.theme;
    return [{ dir, name, section, description: manifest.description, run: record.made === "run", reference, light: `${global}:${light}`, dark: `${global}:${dark}` }];
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---

{studies.length === 0 && <p>No studies yet.</p>}
{
  studies.map((study) => (
    <section class="study" aria-labelledby={`study-${study.dir}`}>
      <h2 id={`study-${study.dir}`}>{study.name}</h2>
      {study.description && <p>{study.description}</p>}
      {study.reference?.image && <img class="study-reference" src={study.reference.image} alt={`The picture ${study.name} was built from`} />}
      <LiveStory
        id={storyId(`${study.section}/Dashboards/Examples`, "Phone")}
        title={`${study.name} on a phone`}
        device="Phone"
        width={390}
        height={844}
        light={study.light}
        dark={study.dark}
        link={false}
      />
      <p class="study-links">
        <a href={`${storybook}?path=/docs/${story(docsId(`${study.section}/Read me first`))}`} target="_blank" rel="noopener">Read me first, in Storybook</a>
        {study.run && <>{" · "}<a href={`${repo}/blob/main/src/skins/${study.dir}/REPORT.md`} target="_blank" rel="noopener">The agent's report</a></>}
        {" · "}
        <a href={`${repo}/tree/main/src/skins/${study.dir}`} target="_blank" rel="noopener">Its source</a>
      </p>
    </section>
  ))
}

<style>
  .study + .study {
    margin-top: 2.5rem;
  }

  .study-links {
    font-size: var(--sl-text-sm);
  }

  .study-reference {
    max-width: min(16rem, 100%);
    border-radius: 0.5rem;
  }
</style>
