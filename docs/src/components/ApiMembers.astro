---
/**
 * A type's members as a typed list: each name, whether it is optional, its type and its doc comment, all read from
 * the package's declaration (`docs/src/lib/api.ts`). `name` is a type, or a component whose props are listed. The
 * words belong in the declaration's doc comments, where an editor shows them too; `notes` is for a member whose words
 * only make sense on one page.
 */
import { members } from "../lib/api";

interface Props {
  from: string;
  name: string;
  only?: string[];
  omit?: string[];
  /** Leave out the members of another type: a tile's props without the hook options it passes on. */
  except?: { from: string; name: string };
  notes?: Record<string, string>;
}


const { from, name, only, omit, except, notes = {} } = Astro.props;
const skip = new Set(except ? members(except.from, except.name).map((member) => member.name) : []);
const list = members(from, name, { only, omit }).filter((member) => !skip.has(member.name));
---

<dl class="api-members">
  {
    list.map((member) => (
      <div>
        <dt>
          <code class="api-name">{member.name}{member.optional ? "?" : ""}</code>
          <code class="api-type">{member.type}</code>
        </dt>
        {(notes[member.name] ?? member.doc) && <dd>{notes[member.name] ?? member.doc}</dd>}
      </div>
    ))
  }
</dl>

<style>
  .api-members {
    display: grid;
    gap: 0.25rem;
    margin-block: 1rem;
  }

  .api-members > div {
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  dt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }

  .api-name {
    font-weight: 600;
  }

  .api-type {
    color: var(--sl-color-gray-2);
    background: none;
    padding: 0;
    overflow-wrap: anywhere;
  }

  dd {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-sm);
  }
</style>
