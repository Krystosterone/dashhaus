{
  "name": "@dashhaus/core",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "description": "The Home Assistant foundation behind Dashhaus skins: entity models, the store, mappers, actions, useHa hooks and interaction primitives, headless; and, on its ./lovelace subpaths, the framework a skin's Lovelace card draws on.",
  "keywords": [
    "home-assistant",
    "react",
    "hooks",
    "headless",
    "dashboard",
    "lovelace"
  ],
  "homepage": "https://krystosterone.github.io/dashhaus/",
  "bugs": {
    "url": "https://github.com/Krystosterone/dashhaus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krystosterone/dashhaus.git",
    "directory": "packages/core"
  },
  "author": "Krystian Czesak",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./entities": {
      "source": "./src/entities/index.ts",
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js",
      "default": "./dist/entities/index.js"
    },
    "./entities/*": {
      "source": "./src/entities/*.ts",
      "types": "./dist/entities/*.d.ts",
      "import": "./dist/entities/*.js",
      "default": "./dist/entities/*.js"
    },
    "./primitives": {
      "source": "./src/primitives/index.ts",
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "default": "./dist/primitives/index.js"
    },
    "./hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./seeds/*": {
      "source": "./src/seeds/*.ts",
      "types": "./dist/seeds/*.d.ts",
      "import": "./dist/seeds/*.js",
      "default": "./dist/seeds/*.js"
    },
    "./perf": {
      "source": "./src/perf.ts",
      "types": "./dist/perf.d.ts",
      "import": "./dist/perf.js",
      "default": "./dist/perf.js"
    },
    "./websocket": {
      "source": "./src/websocket.ts",
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js",
      "default": "./dist/websocket.js"
    },
    "./demo": {
      "source": "./src/demo/index.ts",
      "types": "./dist/demo/index.d.ts",
      "import": "./dist/demo/index.js",
      "default": "./dist/demo/index.js"
    },
    "./testing": {
      "source": "./src/testing.tsx",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./lovelace": {
      "source": "./src/lovelace/index.ts",
      "types": "./dist/lovelace/index.d.ts",
      "import": "./dist/lovelace/index.js",
      "default": "./dist/lovelace/index.js"
    },
    "./lovelace/skin": {
      "source": "./src/lovelace/skin.ts",
      "types": "./dist/lovelace/skin.d.ts",
      "import": "./dist/lovelace/skin.js",
      "default": "./dist/lovelace/skin.js"
    },
    "./lovelace/card": {
      "source": "./src/lovelace/card.tsx",
      "types": "./dist/lovelace/card.d.ts",
      "import": "./dist/lovelace/card.js",
      "default": "./dist/lovelace/card.js"
    },
    "./lovelace/schema": {
      "source": "./src/lovelace/schema.ts",
      "types": "./dist/lovelace/schema.d.ts",
      "import": "./dist/lovelace/schema.js",
      "default": "./dist/lovelace/schema.js"
    },
    "./lovelace/layout": {
      "source": "./src/lovelace/layout.ts",
      "types": "./dist/lovelace/layout.d.ts",
      "import": "./dist/lovelace/layout.js",
      "default": "./dist/lovelace/layout.js"
    },
    "./lovelace/conformance": {
      "source": "./src/lovelace/conformance.ts",
      "types": "./dist/lovelace/conformance.d.ts",
      "import": "./dist/lovelace/conformance.js",
      "default": "./dist/lovelace/conformance.js"
    },
    "./fixtures/*": {
      "source": "./src/ha/fixtures/*",
      "default": "./dist/ha/fixtures/*"
    }
  },
  "peerDependencies": {
    "@testing-library/react": "^16.0.0",
    "home-assistant-js-websocket": "^9.7.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "vitest": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "home-assistant-js-websocket": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
