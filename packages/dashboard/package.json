{
  "name": "@dashhaus/dashboard",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./skin": {
      "source": "./src/skin.ts",
      "types": "./dist/skin.d.ts",
      "import": "./dist/skin.js",
      "default": "./dist/skin.js"
    },
    "./card": {
      "source": "./src/card.tsx",
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js",
      "default": "./dist/card.js"
    },
    "./schema": {
      "source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./layout": {
      "source": "./src/layout.ts",
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "default": "./dist/layout.js"
    },
    "./conformance": {
      "source": "./src/conformance.ts",
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    }
  },
  "dependencies": {
    "@dashhaus/core": "^0.2.0"
  },
  "peerDependencies": {
    "home-assistant-js-websocket": "^9.7.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "home-assistant-js-websocket": {
      "optional": true
    }
  }
}
