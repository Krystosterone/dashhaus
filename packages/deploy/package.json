{
  "name": "@dashhaus/deploy",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "description": "Deploy a Dashhaus dashboard into Home Assistant: copy each file, register its resource and create the dashboards from dashboard.config.mjs.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "deploy",
    "cli",
    "dashboard"
  ],
  "homepage": "https://krystosterone.github.io/dashhaus/",
  "bugs": {
    "url": "https://github.com/Krystosterone/dashhaus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krystosterone/dashhaus.git",
    "directory": "packages/deploy"
  },
  "author": "Krystian Czesak",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "dashhaus-deploy": "./bin.js"
  },
  "exports": {
    ".": "./src/deploy.js",
    "./config": {
      "types": "./src/config.d.ts",
      "import": "./src/config.js",
      "default": "./src/config.js"
    }
  },
  "files": [
    "bin.js",
    "src/*.js",
    "src/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  }
}
