{
  "name": "@dashhaus/deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dashhaus-deploy": "./bin.mjs"
  },
  "exports": {
    ".": "./src/deploy.mjs",
    "./config": {
      "types": "./src/config.d.mts",
      "import": "./src/config.mjs",
      "default": "./src/config.mjs"
    }
  },
  "files": [
    "bin.mjs",
    "src/*.mjs",
    "src/*.d.mts",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "0.25.12"
  }
}
