# Copy to .env (never committed) and fill in, then run `npm run deploy`.

# Your Home Assistant address, as you open it in a browser.
HA_URL=http://homeassistant.local:8123

# Profile (bottom left) → Security → Long-lived access tokens → Create token. Needs an admin user.
HA_TOKEN=

# Where Home Assistant's /config/www folder is. Either over SSH (the "Terminal & SSH" or "Advanced SSH &
# Web Terminal" add-on, with your public key added to it):
HA_WWW=root@homeassistant.local:/config/www
# HA_SSH_PORT=22
# ...or a folder on this machine: the Samba add-on's share mounted at /Volumes/config, or a Docker volume.
# HA_WWW=/Volumes/config/www

# Optional: each dashboard's URL path (must contain a hyphen) and its title in the sidebar, Orb's then Field's.
# HA_DASHBOARD=home-dashboard
# HA_DASHBOARD_TITLE=Home (Orb)
# HA_FIELD_DASHBOARD=home-dashboard-field
# HA_FIELD_DASHBOARD_TITLE=Home (Field)
