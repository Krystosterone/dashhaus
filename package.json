{
  "name": "dashhaus",
  "description": "React and TypeScript skins for a custom Home Assistant dashboard, developed and verified in Storybook.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@11.18.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-npm.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:ha": "node scripts/build-resources.js",
    "build:packages": "node scripts/build-packages.js",
    "docs": "npm run dev -w docs",
    "build:docs": "npm run build -w docs && storybook build --quiet -o docs/dist/storybook",
    "deploy": "dashhaus-deploy",
    "typecheck": "node scripts/typecheck.js",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache",
    "test": "vitest run --config config/vitest.config.ts --maxWorkers=6",
    "test:unit": "vitest run --config config/vitest.config.ts --exclude \"scripts/**\"",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:generators": "vitest run --config config/vitest.config.ts scripts",
    "test-storybook": "storybook build --test --quiet && node scripts/test-storybook.js",
    "perf:collect": "node scripts/perf/collect.js",
    "check": "npm run typecheck && npm run lint && npm run test",
    "new-card": "node scripts/new-card/index.js",
    "new-skin": "node scripts/new-skin/index.js",
    "domains": "node scripts/domains.js",
    "study": "node scripts/study/run.js",
    "study:keep": "node scripts/study/keep.js",
    "change": "node scripts/release/changes.js add",
    "release": "node scripts/release/prepare.js",
    "release:version": "node scripts/release/version.js",
    "release:pack": "node scripts/release/pack.js",
    "release:check": "npm run release:pack && npm run verify:packages",
    "verify:packages": "node scripts/release/verify.js",
    "release:registry": "node scripts/release/registry.js",
    "release:api": "node scripts/release/api.js",
    "release:digests": "node scripts/release/pack.js && node scripts/release/candidate.js write"
  },
  "dependencies": {
    "@dashhaus/core": "*",
    "@dashhaus/deploy": "*",
    "@dashhaus/fake-home-assistant": "*",
    "@dashhaus/field": "*",
    "@dashhaus/orb": "*",
    "home-assistant-js-websocket": "9.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/icons": "2.2.0",
    "@storybook/react": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@storybook/test-runner": "0.26.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-playwright": "2.2.2",
    "create-dashhaus-skin": "*",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "workspaces": [
    "packages/*",
    "src/skins/*",
    "docs"
  ],
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "fsevents": false
  }
}
