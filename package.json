{
  "name": "home-dashboard",
  "description": "React and TypeScript skins for a custom Home Assistant dashboard, developed and verified in Storybook.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:ha": "vite build -c vite.lovelace.config.ts",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-storybook": "storybook build && node scripts/test-storybook.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "new-card": "node scripts/new-card/index.mjs",
    "new-skin": "node scripts/new-skin/index.mjs"
  },
  "dependencies": {
    "home-assistant-js-websocket": "9.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@scope/core": "*",
    "@scope/dashboard": "*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test-runner": "0.21.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-playwright": "2.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "storybook": "8.6.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "5.4.19",
    "vitest": "3.2.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
