{
  "name": "dashhaus",
  "description": "React and TypeScript skins for a custom Home Assistant dashboard, developed and verified in Storybook.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "npm@11.18.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-npm.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:ha": "node scripts/build-bundle.js",
    "build:packages": "node scripts/build-packages.js",
    "docs": "npm run dev -w docs",
    "build:docs": "npm run build -w docs && storybook build --quiet -o docs/dist/storybook",
    "deploy": "dashhaus-deploy",
    "typecheck": "node scripts/typecheck.js",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache",
    "test": "vitest run --config config/vitest.config.ts --maxWorkers=6",
    "test:unit": "vitest run --config config/vitest.config.ts --exclude \"scripts/**\"",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:generators": "vitest run --config config/vitest.config.ts scripts",
    "test-storybook": "storybook build --test --quiet && node scripts/test-storybook.js",
    "perf:collect": "node scripts/perf/collect.js",
    "check": "node scripts/check.js",
    "new-card": "node scripts/new-card/index.js",
    "new-skin": "node scripts/new-skin/index.js",
    "domains": "node scripts/domains.js",
    "study": "node scripts/study/run.js",
    "study:keep": "node scripts/study/keep.js",
    "release:version": "node scripts/release/version.js",
    "release:pack": "node scripts/release/pack.js",
    "release:check": "npm run release:pack && npm run verify:packages",
    "verify:packages": "node scripts/release/verify.js"
  },
  "dependencies": {
    "home-assistant-js-websocket": "9.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@dashhaus/core": "*",
    "@dashhaus/dashboard": "*",
    "@dashhaus/deploy": "*",
    "@dashhaus/fake-home-assistant": "*",
    "@dashhaus/orb": "*",
    "@dashhaus/field": "*",
    "@dashhaus/bundle": "*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test-runner": "0.21.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-playwright": "2.2.2",
    "create-dashhaus-skin": "*",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "storybook": "8.6.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "5.4.19",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "packages/*",
    "src/skins/*",
    "docs"
  ]
}
